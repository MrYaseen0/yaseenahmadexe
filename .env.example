# ---- Database (Prisma / Postgres) ----
# Supabase or any Postgres connection string.
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# ---- GitHub API (portfolio projects / profile) ----
# Personal access token, read-only (public_repo scope is enough).
GITHUB_TOKEN=""

# ---- Admin authentication ----
# Secret used to sign admin session tokens (HMAC-SHA256). REQUIRED.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Admin login email.
ADMIN_EMAIL="you@example.com"

# Preferred: scrypt$salt$hash. Generate with scripts/hash-password.mjs via stdin.
# Existing SHA-256 values remain accepted only to avoid locking out the owner.
# Replace the legacy env value with scrypt and rotate AUTH_SECRET to revoke all sessions.
ADMIN_PASSWORD_HASH=""

# ---- Lead email notifications (Resend) ----
# API key from https://resend.com/api-keys (free tier is enough for self-alerts).
RESEND_API_KEY=""
# Your own email where new contact/hire/booking alerts go.
LEAD_NOTIFY_EMAIL="you@example.com"
# Optional: sender address. Free tier uses onboarding@resend.dev (self-only).
# For client-facing mail, verify your own domain at resend.com/domains.
# LEAD_FROM_EMAIL="alerts@yourdomain.com"
