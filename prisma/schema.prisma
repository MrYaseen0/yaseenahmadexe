// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Contact messages sent through the website form
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  website   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([read])
}

// Hiring requests with project details
model HireRequest {
  id           String   @id @default(cuid())
  name         String
  email        String
  company      String?
  projectType  String
  budget       String?
  timeline     String?
  description  String
  status       String   @default("pending") // pending, reviewed, accepted, declined
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

// Real-time chat messages (persisted for history)
model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  sender    String // "visitor" | "owner"
  name      String?
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

// Newsletter / email subscribers
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Visitor-submitted testimonials (pending approval before public display)
model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  company   String?
  email     String
  rating    Int      @default(5)
  message   String
  approved  Boolean  @default(false)
  avatar    String?
  color     String   @default("sky")
  createdAt DateTime @default(now())

  @@index([approved])
  @@index([createdAt])
}

// Blog articles written by Yaseen
model Article {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  content   String
  tags      String
  coverColor String  @default("sky")
  readTime  Int      @default(5)
  published Boolean  @default(true)
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([createdAt])
}

// Booking requests for consultation calls
model Booking {
  id        String   @id @default(cuid())
  name      String
  email     String
  purpose   String
  date      String
  time      String
  timezone  String
  notes     String?
  status    String   @default("pending") // pending, confirmed, declined, completed
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
  @@index([date])
}

// Anonymous visitor stats (privacy-respecting — IPs are hashed, never stored raw)
model Visit {
  id         String   @id @default(cuid())
  section    String   // which section was viewed (e.g. "home", "projects", "pageview")
  referrer   String?  // where the visitor came from (origin only)
  path       String   // page path
  sessionId  String?  // anonymous per-tab session id (for bounce rate)
  ipHash     String?  // sha256(ip) — unique-visitor counting without storing IPs
  country    String?  // from x-vercel-ip-country header
  device     String?  // Desktop | Mobile | Tablet
  browser    String?  // Chrome | Edge | Firefox | Safari | ...
  os         String?  // Windows | macOS | Android | iOS | Linux | ...
  isPageview Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([section])
  @@index([createdAt])
  @@index([sessionId])
  @@index([ipHash])
  @@index([path])
}

// Security / attack events: failed logins, rate-limit hits, bursts (DDoS-like)
model SecurityEvent {
  id        String   @id @default(cuid())
  type      String   // FAILED_LOGIN | RATE_LIMIT | BURST | BLOCKED_HIT | SUSPICIOUS
  ip        String   // attacker IP (raw — needed for blocking)
  path      String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([ip])
  @@index([createdAt])
}

// Manually or automatically blocked IPs
model BlockedIp {
  id        String   @id @default(cuid())
  ip        String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

// Editable site content (key-value store for dynamic website data)
model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "hero_name", "hero_tagline", "contact_email"
  value     String
  category  String   @default("general") // hero, about, contact, services, etc.
  updatedAt DateTime @updatedAt

  @@index([category])
}

// Unified professional audit log: every admin login, admin page view, admin
// action, and every attack event — enriched at write time with geo/ISP and a
// stable device fingerprint. This is the single timeline shown in /admin.
model AuditLog {
  id        String   @id @default(cuid())
  event     String   // ADMIN_LOGIN | ADMIN_LOGOUT | ADMIN_PAGE_VIEW | ADMIN_ACTION | CONTENT_EDIT | FAILED_LOGIN | RATE_LIMIT | BURST | BLOCKED_HIT | SUSPICIOUS
  actor     String?  // admin email when known (logins / actions)
  ip        String?  // raw IP — needed for security work
  ipHash    String?  // sha256(ip) for correlation without showing raw IP everywhere
  city      String?
  region    String?
  country   String?
  isp       String?
  device    String?  // Desktop | Mobile | Tablet
  browser   String?
  os        String?
  deviceId  String?  // stable fingerprint: sha256(ip + user-agent), 16 chars
  path      String?
  detail    String?  // human-readable summary
  createdAt DateTime @default(now())

  @@index([event])
  @@index([createdAt])
  @@index([ip])
  @@index([actor])
  @@index([deviceId])
}
