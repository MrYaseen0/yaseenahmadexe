// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Contact messages sent through the website form
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  website   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([read])
}

// Hiring requests with project details
model HireRequest {
  id           String   @id @default(cuid())
  name         String
  email        String
  company      String?
  projectType  String
  budget       String?
  timeline     String?
  description  String
  status       String   @default("pending") // pending, reviewed, accepted, declined
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

// Real-time chat messages (persisted for history)
model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  sender    String // "visitor" | "owner"
  name      String?
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

// Newsletter / email subscribers
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Visitor-submitted testimonials (pending approval before public display)
model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  company   String?
  email     String
  rating    Int      @default(5)
  message   String
  approved  Boolean  @default(false)
  avatar    String?
  color     String   @default("sky")
  createdAt DateTime @default(now())

  @@index([approved])
  @@index([createdAt])
}

// Blog articles written by Yaseen
model Article {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  content   String
  tags      String
  coverColor String  @default("sky")
  readTime  Int      @default(5)
  published Boolean  @default(true)
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([createdAt])
}

// Booking requests for consultation calls
model Booking {
  id        String   @id @default(cuid())
  name      String
  email     String
  purpose   String
  date      String
  time      String
  timezone  String
  notes     String?
  status    String   @default("pending") // pending, confirmed, declined, completed
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
  @@index([date])
}
